# Copy to .env (never commit real keys). All optional; honest fallbacks when empty.
HOST=127.0.0.1
PORT=5000
APP_DEBUG=false
# SERP: serper (recommended first-class) | dataforseo | ddg_fallback
SERP_PROVIDER=ddg_fallback
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Live LLM citation testing (M22) — without these M22 runs honest_mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
PERPLEXITY_MODEL=sonar
# Core Web Vitals field+lab data
PSI_API_KEY=
CRUX_API_KEY=
# Search Console OAuth (else CSV fallback)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SERVICE_JSON=
# GA4 attribution stub
GA4_PROPERTY_ID=
# Enterprise auth: "ws1:key1,ws2:key2" (empty = open single-tenant)
ENTERPRISE_API_KEYS=
ENTERPRISE_SSO_ISSUER=
# SQLite persistence
PLATFORM_DB=intent_entity_platform/data/platform.sqlite3
